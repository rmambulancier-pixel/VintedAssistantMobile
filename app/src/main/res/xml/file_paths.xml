<?xml version="1.0" encoding="utf-8"?>
<!-- Seuls ces deux dossiers privés peuvent être partagés vers une autre application. -->
<paths>
    <files-path name="photos" path="photos/" />
    <files-path name="labels" path="labels/" />
    <!-- Export des données de l'application (ZIP sans photos), partagé à la demande. -->
    <cache-path name="exports" path="exports/" />
    <!-- Sauvegarde complète envoyée à la demande (Drive, e-mail…). -->
    <cache-path name="backups" path="backups/" />
    <!-- Photos prises avec l'appareil photo (mise en vente express), supprimées après import. -->
    <cache-path name="camera" path="camera/" />
</paths>
